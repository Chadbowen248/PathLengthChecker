<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PathLengthChecker</RootNamespace>
    <AssemblyName>PathLengthChecker</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>2.0.0</Version>
    <Authors>Daniel Schroeder; PathLengthChecker fork contributors</Authors>
    <Description>Path length checker with OneDrive migration helpers (fork of deadlydog/PathLengthChecker).</Description>
  </PropertyGroup>
</Project>
