<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PathLengthCheckerGUI</RootNamespace>
    <AssemblyName>PathLengthCheckerGUI</AssemblyName>
    <ApplicationIcon>Images\PathLengthCheckerIcon.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Authors>Daniel Schroeder; PathLengthChecker fork contributors</Authors>
    <Description>Modern GUI for Path Length Checker with OneDrive migration helpers.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Images\PathLengthCheckerIcon.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PathLengthChecker\PathLengthChecker.csproj" />
  </ItemGroup>
</Project>
