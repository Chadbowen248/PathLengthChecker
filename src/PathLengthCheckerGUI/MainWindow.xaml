<Window x:Class="PathLengthCheckerGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:PathLengthChecker="clr-namespace:PathLengthChecker;assembly=PathLengthChecker"
        xmlns:System="clr-namespace:System;assembly=System.Runtime"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        Title="Path Length Checker"
        MinWidth="900" MinHeight="560"
        Width="980" Height="760"
        FocusManager.FocusedElement="{Binding ElementName=txtRootDirectory}"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
  <Window.Resources>
    <ObjectDataProvider MethodName="GetValues" ObjectType="{x:Type System:Enum}" x:Key="FileSystemTypesEnumValues">
      <ObjectDataProvider.MethodParameters>
        <x:Type TypeName="PathLengthChecker:FileSystemTypes" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider MethodName="GetValues" ObjectType="{x:Type System:Enum}" x:Key="DisplayModeEnumValues">
      <ObjectDataProvider.MethodParameters>
        <x:Type TypeName="PathLengthChecker:PathDisplayMode" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <CollectionViewSource x:Key="PathsCollectionViewSource" Source="{Binding Paths}">
      <CollectionViewSource.SortDescriptions>
        <scm:SortDescription PropertyName="Length" Direction="Descending"/>
        <scm:SortDescription PropertyName="Path" Direction="Ascending"/>
      </CollectionViewSource.SortDescriptions>
    </CollectionViewSource>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="Path Length Checker" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="Scan a share, mock the OneDrive destination, and export a clean cleanup list for clients."
                   Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
      </StackPanel>
      <Button DockPanel.Dock="Right" Content="OneDrive preset (400)" Style="{StaticResource SecondaryButton}"
              Click="btnOneDrivePreset_Click"
              ToolTip="Sets Min Path Length to 400 (OneDrive/SharePoint limit), enables strip-on-copy, destination display, and sorts longest first."
              VerticalAlignment="Center" Margin="12,0,0,0"/>
    </DockPanel>

    <!-- Scan options -->
    <GroupBox Grid.Row="1" Header="1. Scan and mock destination">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="40"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Starting directory" VerticalAlignment="Center"
                     ToolTip="Root directory / share path to scan."/>
          <TextBox Grid.Column="1" Name="txtRootDirectory"
                   ToolTip="Root directory / share path to scan."/>
          <Button Grid.Column="2" Content="..." Name="btnBrowseForRootDirectory"
                  Click="btnBrowseForRootDirectory_Click" Margin="6,0,0,0"
                  ToolTip="Browse for a folder to search in."/>
        </Grid>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Include" VerticalAlignment="Center"/>
          <ComboBox Grid.Column="1" Name="cmbTypesToInclude"
                    ItemsSource="{Binding Source={StaticResource FileSystemTypesEnumValues}}"
                    ToolTip="Files, directories, or both."/>
          <CheckBox Grid.Column="3" Name="chkIncludeSubdirectories" Content="Include subdirectories"
                    ToolTip="Search all subdirectories under the starting directory."/>
          <TextBlock Grid.Column="5" Text="Min length" VerticalAlignment="Center" Margin="0,0,6,0"
                     ToolTip="Only return paths whose scored length is at least this many characters. Use 400 for OneDrive over-limit list."/>
          <TextBox Grid.Column="6" Name="numMinPathLength" Text="0" Width="70"/>
          <TextBlock Grid.Column="8" Text="Max length" VerticalAlignment="Center" Margin="0,0,6,0"
                     ToolTip="Only return paths whose scored length is at most this many characters. Use 999999 for no max."/>
          <TextBox Grid.Column="9" Name="numMaxPathLength" Text="999999" Width="70"/>
        </Grid>

        <Grid Grid.Row="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Search pattern" VerticalAlignment="Center"
                     ToolTip="Wildcard pattern for names. * matches any characters."/>
          <TextBox Grid.Column="1" Name="txtSearchPattern" ToolTip="e.g. * or *.pdf"/>
        </Grid>

        <Grid Grid.Row="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <CheckBox Name="chkReplaceRootDirectory"
                      Content="Replace the Starting Directory in the returned paths with (destination / OneDrive mock):"
                      ToolTip="Length is calculated using this replacement so you can mock the future OneDrive path."/>
            <Button Grid.Column="1" Content="..." Name="btnBrowseForReplaceRootDirectory"
                    Click="btnBrowseForReplaceRootDirectory_Click" Margin="6,0,0,0"
                    IsEnabled="{Binding ElementName=chkReplaceRootDirectory, Path=IsChecked}"/>
          </Grid>
          <TextBox Grid.Row="2" Name="txtReplaceRootDirectory"
                   IsEnabled="{Binding ElementName=chkReplaceRootDirectory, Path=IsChecked}"
                   ToolTip="e.g. C:\Users\jdoe\OneDrive - Contoso\General"/>
          <CheckBox Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                    Name="chkUrlEncodePaths" Content="URL encode paths"
                    ToolTip="Percent-encode scored paths (spaces -> %20, etc.)."/>
        </Grid>
      </Grid>
    </GroupBox>

    <!-- Actions -->
    <Grid Grid.Row="2" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Name="btnGetPathLengths" Content="Get path lengths"
              Style="{StaticResource PrimaryButton}" FontSize="18" Height="52"
              Click="btnGetPathLengths_Click" IsDefault="True"/>
      <Button Grid.Column="0" Name="btnCancelGetPathLengths" Content="Cancel"
              Style="{StaticResource PrimaryButton}" FontSize="18" Height="52"
              Click="btnCancelGetPathLengths_Click" Visibility="Collapsed"/>
      <Button Grid.Column="1" Name="btnResetAllOptions" Content="Reset options"
              Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Width="120"
              Click="btnResetAllOptions_Click"
              ToolTip="Reset search and replacement fields to defaults."/>
    </Grid>

    <!-- Results -->
    <GroupBox Grid.Row="3" Header="2. Results and client handoff">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0">
          <TextBlock Text="Display path as" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox Name="cmbDisplayMode" Width="140" Margin="0,0,16,0"
                    ItemsSource="{Binding Source={StaticResource DisplayModeEnumValues}}"
                    SelectionChanged="cmbDisplayMode_SelectionChanged"
                    ToolTip="Change how paths appear without re-scanning. Length always uses the destination/mock path."/>
          <CheckBox Name="chkStripPrefixOnCopy" Content="Strip prefix when copying/exporting"
                    Checked="chkStripPrefixOnCopy_Changed" Unchecked="chkStripPrefixOnCopy_Changed"
                    ToolTip="Remove the destination root from copied/exported paths so clients only see the share-relative folders."/>
          <TextBox Name="txtStripPrefix" Width="320" Margin="8,0,0,0"
                   ToolTip="Prefix to strip (defaults to destination replacement text). Does not change Length."/>
        </WrapPanel>

        <DataGrid Grid.Row="2" Name="dgPaths" AutoGenerateColumns="False" IsReadOnly="True"
                  IsTabStop="False" LoadingRow="dgPaths_LoadingRow"
                  ItemsSource="{Binding Source={StaticResource PathsCollectionViewSource}}"
                  SelectedItem="{Binding Path=SelectedPath, Mode=TwoWay}"
                  FontFamily="Consolas" CanUserSortColumns="True"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Length" Binding="{Binding Path=Length}" SortMemberPath="Length" Width="80"/>
            <DataGridTextColumn Header="Path" Binding="{Binding Path=DisplayPath}" SortMemberPath="DisplayPath" Width="*"/>
          </DataGrid.Columns>
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Open directory in File Explorer" Click="MenuItem_OpenDirectoryInFileExplorer_Click"/>
            </ContextMenu>
          </DataGrid.ContextMenu>
        </DataGrid>

        <Grid Grid.Row="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Name="txtNumberOfPaths" Text=""/>
            <TextBlock Name="txtMinAndMaxPathLengths" Text="" Foreground="#64748B"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <CheckBox Name="chkIncludeLengthsOnCopy" Content="Include lengths" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Copy paths" Style="{StaticResource SecondaryButton}" Click="btnCopyPaths_Click"
                    ToolTip="Copy visible paths in current sort order (respects display mode and strip-prefix)."/>
            <Button Content="Copy as CSV" Style="{StaticResource SecondaryButton}" Click="btnCopyCsv_Click"/>
            <Button Content="Export…" Style="{StaticResource SecondaryButton}" Click="btnExport_Click"
                    ToolTip="Save results to a .txt or .csv file for the client."/>
          </StackPanel>
        </Grid>
      </Grid>
    </GroupBox>

    <TextBlock Grid.Row="4" Margin="0,8,0,0" Foreground="#94A3B8" FontSize="11"
               Text="Fork of deadlydog/PathLengthChecker (MIT). Length uses destination replacement; strip-on-copy is for client-friendly lists only."/>
  </Grid>
</Window>
